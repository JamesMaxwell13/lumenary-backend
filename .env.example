DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,bonus-kosher-walrus.ngrok-free.dev
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bonus-kosher-walrus.ngrok-free.dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bonus-kosher-walrus.ngrok-free.dev
ADMIN_BASE_URL=http://localhost:8000

POSTGRES_DB=Lumenary
POSTGRES_USER=Lumenary
POSTGRES_PASSWORD=Lumenary
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional Redis connection. Leave empty unless Redis/Celery jobs are enabled.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Optional cache backend. Empty uses Django's in-memory cache.
CACHE_URL=
CACHE_TIMEOUT=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_PUBLIC_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_QUERYSTRING_AUTH=false
AWS_DEFAULT_ACL=
AWS_S3_FILE_OVERWRITE=false
AWS_S3_VERIFY=true
AWS_S3_MAX_MEMORY_SIZE=0
AWS_S3_CACHE_CONTROL=public, max-age=86400

USE_X_FORWARDED_HOST=true
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
