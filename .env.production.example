COMPOSE_PROJECT_NAME=lumenary
SITE_HOST=192.168.1.50
SITE_URL=http://192.168.1.50
ENABLE_HTTPS=false
LETSENCRYPT_EMAIL=admin@example.com
MINIO_CONSOLE_PORT=9001
BACKUP_RETENTION_DAYS=14

BACKEND_IMAGE=ghcr.io/owner/lumenary-backend:main
FRONTEND_IMAGE=ghcr.io/owner/lumenary-frontend:main

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=192.168.1.50
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.50
CORS_ALLOWED_ORIGINS=http://192.168.1.50
ADMIN_BASE_URL=http://192.168.1.50

POSTGRES_DB=Lumenary
POSTGRES_USER=Lumenary
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CACHE_URL=
CACHE_TIMEOUT=60

AWS_ACCESS_KEY_ID=lumenary
AWS_SECRET_ACCESS_KEY=change-me
AWS_STORAGE_BUCKET_NAME=lumenary-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_URL=http://192.168.1.50/media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_QUERYSTRING_AUTH=false
AWS_DEFAULT_ACL=
AWS_S3_FILE_OVERWRITE=false
AWS_S3_VERIFY=true
AWS_S3_MAX_MEMORY_SIZE=0
AWS_S3_CACHE_CONTROL=public, max-age=86400

USE_X_FORWARDED_HOST=true
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=180
